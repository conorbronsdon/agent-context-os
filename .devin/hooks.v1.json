{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"$DEVIN_PROJECT_DIR/scripts/context-os-hook.sh\" devin session-start cli",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(edit|write|apply_patch|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"$DEVIN_PROJECT_DIR/scripts/context-os-hook.sh\" devin pre-write cli",
          "timeout": 10
        }
      ]
    }
  ]
}
