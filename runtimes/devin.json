{
  "schema_version": 2,
  "runtime": "devin",
  "display_name": "Devin",
  "support_tier": "first-class",
  "support_summary": "First-class Devin CLI lifecycle and handoff with exact-version evidence and an import guard; cloud sessions remain experimental and Devin Review is instruction-only compatibility",
  "components": [
    "core",
    "portable-skills",
    "agents-instructions",
    "devin-adapter"
  ],
  "install": {
    "mode": "native-project-discovery",
    "next_steps": [
      "Install Devin CLI separately, run devin auth login, start devin from this repository root, and record devin version.",
      "Keep the shipped .devin/config.json so Devin loads AGENTS.md and .agents/skills without importing Claude, Cursor, Windsurf, Copilot, OpenCode, or Zed configuration.",
      "Invoke /context-setup, /context-start, /context-update, and /context-end explicitly in Normal mode and approve apply only for the exact proposal digest you reviewed.",
      "For cloud sessions, connect and authorize the repository in Devin and verify the Blueprint build and snapshot; local registration does not prove account access."
    ]
  },
  "onboarding_doc": "adapters/devin/README.md",
