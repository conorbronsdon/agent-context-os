  "components": ["core", "portable-skills", "agents-instructions", "codex-adapter"],
  "install": {
    "mode": "repository-native",
    "next_steps": [
      "Launch Codex from the repository root.",
      "Review the trusted .codex layer and project hooks, then run $setup or $start."
