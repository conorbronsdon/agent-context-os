      },
      "paths": {
        "state_dir": "memory",
        "sessions_dir": "work/sessions",
        "task_file": "TASKS.md"
      },
      "template": {
        "version": "9.9.9",
        "source": "private-bundle",
        "bundle_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    }
  },
  {
