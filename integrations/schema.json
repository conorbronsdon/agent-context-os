{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/conorbronsdon/claude-context-os/blob/main/integrations/schema.json",
  "title": "claude-context-os optional integration catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integrations"],
  "properties": {
    "schema_version": {"const": 1},
    "integrations": {
      "type": "array",
      "items": {"$ref": "#/$defs/integration"}
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "summary", "source_url", "kind", "supported_agents",
        "installation", "data_boundary", "capabilities", "confirmation",
        "risk_tags", "maturity", "last_verified", "health_check", "uninstall"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https://"},
        "kind": {"enum": ["mcp_server", "skill_catalog", "workspace_template", "resource_catalog", "local_workspace", "editor_guide", "agent_extension", "connector"]},
        "supported_agents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["claude_code", "codex", "gemini_cli", "cursor", "opencode", "generic"]}
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["automatic", "scope", "prerequisites"],
          "properties": {
            "automatic": {"const": false},
            "scope": {"enum": ["none", "project", "user", "project_or_user"]},
            "prerequisites": {"$ref": "#/$defs/string_array"}
          }
        },
        "data_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credentials", "reads", "writes"],
          "properties": {
            "credentials": {"$ref": "#/$defs/string_array"},
            "reads": {"$ref": "#/$defs/string_array"},
            "writes": {"$ref": "#/$defs/string_array"}
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write", "publish", "destructive", "details"],
          "properties": {
            "read": {"type": "boolean"},
            "write": {"type": "boolean"},
            "publish": {"type": "boolean"},
            "destructive": {"type": "boolean"},
            "details": {"$ref": "#/$defs/string_array"}
          }
        },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_for", "notes"],
          "properties": {
            "required_for": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["credential_setup", "external_install", "write", "publish", "destructive"]}
            },
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "risk_tags": {"$ref": "#/$defs/string_array"},
        "maturity": {"enum": ["verified", "listed", "experimental"]},
        "last_verified": {"type": "string", "format": "date"},
        "health_check": {"type": "string", "minLength": 1},
        "uninstall": {"type": "string", "minLength": 1}
      }
    }
  }
}
